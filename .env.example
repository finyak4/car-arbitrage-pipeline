# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — copy this to .env and fill in real values
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Scraper settings ─────────────────────────────────────────────────────────

# How many pages to crawl during the *discovery* phase.
# The discovery scraper paginates through listing results to collect car URLs.
# 170 pages ≈ 3 000–5 000 listing URLs depending on the source site.
APP_DISCOVERY_PAGES=170

# How many listing detail pages to fetch during the *retrieve* phase.
# Each page corresponds to one individual car listing (full specs, price, photos).
# Set lower (e.g. 50) for quick test runs; use the full value for production.
APP_RETRIEVE_PAGES=1000

# Path to the raw SQLite database produced by the scraping pipeline.
# This is the "input" DB — it holds all scraped listings before cleaning.
APP_DB_PATH="cars_data_pipeline_complete.db"

# Path to the cleaned SQLite database produced after the data-cleaning step.
# This is the "output" DB used for model training and inference.
APP_DB_OUT_PATH="cars_data_clean_new.db"

# Optional: pin the scraper to a specific date's listings (YYYY-MM-DD).
# Leave commented out to always fetch the latest available data.
# APP_DATE_FOR_DATA="2026-08-31"


# ── Airflow ───────────────────────────────────────────────────────────────────

# Linux UID for the Airflow process inside Docker (keeps file permissions sane).
# On Linux: run `id -u` and paste the result here.
# On Windows/macOS with Docker Desktop: 50000 is fine.
AIRFLOW_UID=50000

# Fernet key used by Airflow to encrypt connection passwords and variables.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY="REPLACE_ME_WITH_GENERATED_FERNET_KEY"
